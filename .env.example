FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=aftershock
# The verified submission does not require the experimental workspace UI.
ENABLE_EXPERIMENTAL_WORKSPACES=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# FALKORDB_PASSWORD=
# Optional: enables LLM tool selection. Without a key, the deterministic agent
# still performs real graph traversals and records its evidence.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
